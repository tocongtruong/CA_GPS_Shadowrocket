# Cấu hình Server Cổng & Bảo Mật
PORT=3000
SECRET_TOKEN=my_secret_token_123

# Thời gian lưu trữ dữ liệu (mặc định 30 ngày)
RETENTION_DAYS=30

# Đường dẫn file SQLite Database
DB_PATH=./data/locations.db

# Cấu hình Telegram Bot (Lấy từ @BotFather trên Telegram)
# Nếu chưa dùng bot, bạn có thể để trống
TELEGRAM_BOT_TOKEN=
# Chat ID được phép sử dụng (để trống nếu cho phép tất cả ai chat với bot)
TELEGRAM_ALLOWED_USERS=
